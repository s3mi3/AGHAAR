-- ==================================================================
-- FREEZE: press F to TOGGLE freeze on your own cells. Press F once
-- to hard-stop every one of your cells in place; press F again to
-- release. Cells preserve their split-boost momentum while frozen
-- (velocity is paused, not zeroed), so a mid-flight split resumes
-- its trajectory when you unfreeze. Release also adds a short
-- outward spring so a frozen stack pops apart instead of oozing
-- into a clump. Sibling merges pause while frozen so freeze-feeding
-- cannot swallow the piece you aimed at.
-- Debounce prevents accidental double-taps from cancelling.
-- ==================================================================
Config.Freeze = {
	Enabled = true,
	Debounce = 0.3, -- was 0.15; longer window kills F-spam scatter
	Cost = 0,
	-- Short punchy separation after release. A long weak grace made
	-- freeze-split piles slowly unravel, then mouse-homing clustered them.
	UnfreezeGraceSeconds = 0.4,
	UnfreezeGraceStrength = 0.45,
	UnfreezeGraceCurveExponent = 1.35,
	UnfreezeMaxOverlapPerPass = 14,
	UnfreezePushPasses = 2,
	ReleaseImpulse = 280,
	ReleaseImpulseMinScale = 0.4,
	ReleaseMinHoldSeconds = 0,
	-- Let split/release boost win for a beat before cursor homing.
	UnfreezeSteerLockSeconds = 0.28,
}

