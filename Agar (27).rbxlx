	bar.BorderSizePixel = 0
	bar.Position = UDim2.new(0.5, 0, 0, 10)
	bar.Size = UDim2.new(1, -20, 0, 58)
	bar.Visible = false
	bar.ZIndex = 40
	bar.Parent = self.gui
	corner(bar, 12)
	self.editBar = bar

	local hint = label(bar, "Drag to move · corner square to resize", 14, TEXT, true)
	hint.Position = UDim2.fromOffset(16, 8)
	hint.Size = UDim2.new(1, -150, 0, 42)
	hint.TextWrapped = true

	local done = button(bar, "Done", ACCENT)
	done.AnchorPoint = Vector2.new(1, 0.5)
	done.Position = UDim2.new(1, -12, 0.5, 0)
	done.Size = UDim2.fromOffset(110, 40)
	done.MouseButton1Click:Connect(function()
		self:_endHudEdit(true)
	end)
end

function MainMenu:_hudLayoutPayload()
	local layout = {}
	if self.renderer and self.renderer.getHudLayout then
		for id, entry in self.renderer:getHudLayout() do
			layout[id] = entry
		end
	end
	if self.input and self.input.getHudLayout then
		for id, entry in self.input:getHudLayout() do
			layout[id] = entry
		end
	end
	return layout
end

function MainMenu:_beginHudEdit()
	self.hudEditing = true
	self.hudEditReturnTab = self.tab
	self.dim.Visible = false
	self.panel.Visible = false
	if self.editBar then
		self.editBar.Visible = true
	end
	if self.renderer then
		self.renderer.mainMenuOpen = false
		if self.renderer.setHudEditEnabled then
			self.renderer:setHudEditEnabled(true)
		end
	end
	if self.input and self.input.setHudEditEnabled then
		self.input:setHudEditEnabled(true)
	end
end

function MainMenu:_endHudEdit(save)
	self.hudEditing = false
	if self.editBar then
		self.editBar.Visible = false
	end
	if self.renderer and self.renderer.setHudEditEnabled then
		self.renderer:setHudEditEnabled(false)
	end
	if self.input and self.input.setHudEditEnabled then
		self.input:setHudEditEnabled(false)
	end
	if save then
		local layout = self:_hudLayoutPayload()
		self.hudLayout = layout
		self:_fire({
			action = "settings",
			hudLayout = layout,
			minimapEnabled = self.minimapEnabled ~= false,
		})
	end
	self:setOpen(true)
	self:_showTab(self.hudEditReturnTab or "settings")
end

function MainMenu:_resetHudLayout()
	self.hudLayout = {}
	if self.renderer and self.renderer.resetHudLayout then
		self.renderer:resetHudLayout()
	end
	if self.input and self.input.resetHudLayout then
		self.input:resetHudLayout()
	end
	self:_fire({ action = "settings", hudLayout = {} })
end

function MainMenu:_fire(payload)
	if self.remote then
		self.remote:FireServer(payload)
	end
end

function MainMenu:_play()
	self:_fire({
		action = "play",
		spawnNear = self.social.spawnNearEnabled == true,
		spawnMode = self.spawnMode,
		spawnUserId = self.spawnUserId,
	})
end

function MainMenu:_bindInput()
	UserInputService.InputBegan:Connect(function(input, processed)
		if self.capturingBind and input.KeyCode ~= Enum.KeyCode.Unknown then
			local used = false
			for id, code in self.keybinds do
				if id ~= self.capturingBind and code == input.KeyCode then
					used = true
					break
				end
			end
			if not used then
				self.keybinds[self.capturingBind] = input.KeyCode
				if self.input and self.input.setKeybinds then
					self.input:setKeybinds(self.keybinds)
				end
				self:_fire({
					action = "settings",
					keybinds = self:_keybindPayload(),
				})
			end
			self.capturingBind = nil
			self:_refreshSettings()
			return
		end
		if processed then
			return
		end
		if input.KeyCode == (self.keybinds.menu or Enum.KeyCode.M) then
			if self.hudEditing then
				self:_endHudEdit(true)
				return
			end
			self:setOpen(not self.open)
		end
	end)
end

function MainMenu:_keybindPayload()
	local payload = {}
	for id, code in self.keybinds do
		payload[id] = code.Name
	end
	return payload
end

function MainMenu:_applyMapColor(bg, grid, save)
	self.mapColor = bg
	self.gridColor = grid
	if self.renderer and self.renderer.setMapColors then
		self.renderer:setMapColors(bg, grid)
	end
	if save then
		self:_fire({
			action = "settings",
			mapColor = { bg.R, bg.G, bg.B },
			gridColor = { grid.R, grid.G, grid.B },
		})
	end
end

function MainMenu:setOpen(open)
	local becomingOpen = open == true and self.open ~= true
	self.open = open == true
	self.gui.Enabled = true
	self.dim.Visible = self.open
	self.panel.Visible = self.open
	if self.renderer then
		self.renderer.mainMenuOpen = self.open
	end
	if becomingOpen and self.social.playing then
		local lock = math.max(Config.Social and Config.Social.SpectateLockSeconds or 10, 0)
		self.spectateUnlockAt = os.clock() + lock
		self:_fire({ action = "menuOpen" })
		self:_refreshLockLabel()
	end
end

function MainMenu:isCapturing()
	return self.capturingBind ~= nil
		or self.hudEditing == true
		or (self.nicknameBox ~= nil and self.nicknameBox:IsFocused())
end

function MainMenu:handleUpdate(payload)
	if typeof(payload) ~= "table" then
		return
	end
	if payload.kind == "hello" or payload.kind == "social" or payload.kind == "world" then
		if typeof(payload.playing) == "boolean" then
			self.social.playing = payload.playing
		end
		if typeof(payload.spectating) == "boolean" then
			self.social.spectating = payload.spectating
		end
		if typeof(payload.spectateName) == "string" then
			self.social.spectateName = payload.spectateName
		end
		if typeof(payload.spectateUnlockIn) == "number" then
			self.social.spectateUnlockIn = payload.spectateUnlockIn
			self.spectateUnlockAt = os.clock() + payload.spectateUnlockIn
		end
		if typeof(payload.spawnNearEnabled) == "boolean" then
			self.social.spawnNearEnabled = payload.spawnNearEnabled
		end
		if typeof(payload.minimapEnabled) == "boolean" then
			self.minimapEnabled = payload.minimapEnabled
			if self.renderer and self.renderer.setMinimapEnabled then
				self.renderer:setMinimapEnabled(self.minimapEnabled)
			end
		end
		if payload.kind == "hello" and typeof(payload.nickname) == "string" then
			self.nickname = payload.nickname
			if self.nicknameBox and not self.nicknameBox:IsFocused() then
				self.nicknameBox.Text = payload.nickname
			end
		end
		if payload.kind == "hello" and typeof(payload.avatarDisplayMode) == "string" then
			self.avatarDisplayMode = payload.avatarDisplayMode
		end
		if payload.kind == "hello" and typeof(payload.hudLayout) == "table" then
			self.hudLayout = payload.hudLayout
			if self.renderer and self.renderer.setHudLayout then
				self.renderer:setHudLayout(payload.hudLayout)
			end
			if self.input and self.input.setHudLayout then
				self.input:setHudLayout(payload.hudLayout)
			end
		end
		if typeof(payload.friends) == "table" then
			self.social.friends = payload.friends
		end
		if typeof(payload.incoming) == "table" then
			self.social.incoming = payload.incoming
		end
		if typeof(payload.outgoing) == "table" then
			self.social.outgoing = payload.outgoing
		end
		if typeof(payload.serverPlayers) == "table" then
			self.social.serverPlayers = payload.serverPlayers
		end
		if payload.party == false then
			self.social.party = nil
		elseif typeof(payload.party) == "table" then
			self.social.party = payload.party
		end
		if typeof(payload.leaders) == "table" then
			self.social.leaders = payload.leaders
		end
		if typeof(payload.mapPlayers) == "table" then
			self.social.mapPlayers = payload.mapPlayers
		end
		if typeof(payload.message) == "string" then
			self.statusLabel.Text = payload.message
		end
		if typeof(payload.keybinds) == "table" then
			for id, name in payload.keybinds do
				local code = parseKey(name)
				if code then
					self.keybinds[id] = code
				end
			end
			if self.input and self.input.setKeybinds then
				self.input:setKeybinds(self.keybinds)
			end
		end
		if typeof(payload.mapColor) == "table" and typeof(payload.gridColor) == "table" then
			local bg = Color3.new(payload.mapColor[1] or 1, payload.mapColor[2] or 1, payload.mapColor[3] or 1)
			local grid = Color3.new(payload.gridColor[1] or 0.85, payload.gridColor[2] or 0.88, payload.gridColor[3] or 0.92)
			local pickerOpen = self.pickerFrame and self.pickerFrame.Visible == true
			if not pickerOpen then
				if colorsClose(bg, MAP_LIGHT.bg) then
					self.mapMode = "light"
				elseif colorsClose(bg, MAP_DARK.bg) then
					self.mapMode = "dark"
				else
					self.mapMode = "custom"
					local h, s, v = bg:ToHSV()
					self.pickerH, self.pickerS, self.pickerV = h, s, v
				end
				self:_applyMapColor(bg, grid, false)
			end
		end
		if self.renderer and self.renderer.setSocialWorld then
			self.renderer:setSocialWorld(self.social)
		end
		if payload.kind == "hello" then
			if payload.keepMenuClosed == true then
				self:setOpen(false)
			else
				self:setOpen(payload.playing ~= true)
			end
		end
		self:_refreshAll()
	end
end

function MainMenu:_refreshAll()
	self:_refreshPlay()
	self:_refreshSpawnNear()
	self:_refreshFriends()
	self:_refreshParty()
	self:_refreshSettings()
	self:_refreshSkins()
end

function MainMenu:_saveNickname()
	if not self.nicknameBox then
		return
	end
	local nickname = trimNickname(self.nicknameBox.Text)
	self.nicknameBox.Text = nickname
	if nickname == self.nickname then
		return
	end
	if self.shopRemote then
		self.shopRemote:FireServer({
			action = "nickname",
			nickname = nickname,
		})
	end
end

function MainMenu:_setAvatarMode(mode)
	local requested = mode
	if self.avatarDisplayMode == mode then
		requested = "hidden"
	end
	self.avatarDisplayMode = requested
	self:_refreshSkins()
	if self.shopRemote then
		self.shopRemote:FireServer({
			action = "avatarDisplay",
			mode = requested,
		})
	end
end

function MainMenu:_loadSkinPreviews()
	local userId = self.player and self.player.UserId
	if typeof(userId) ~= "number" or userId &lt;= 0 then
		return
	end
	for _, preview in self.skinPreviews do
		task.spawn(function()
			local ok, image = pcall(function()
				return Players:GetUserThumbnailAsync(userId, preview.info.thumb, Enum.ThumbnailSize.Size420x420)
			end)
			if ok and typeof(image) == "string" and preview.avatar then
				preview.avatar.Image = image
			end
		end)
	end
end

function MainMenu:_refreshSkins()
	if not self.skinPreviews then
		return
	end
	local selected = self.avatarDisplayMode
	for mode, preview in self.skinPreviews do
		local on = selected == mode
		if preview.stroke then
			preview.stroke.Transparency = if on then 0 else 1
		end
		if preview.button then
			preview.button.BackgroundColor3 = if on then ACCENT else Color3.fromRGB(200, 206, 214)
			preview.button.TextColor3 = Color3.fromRGB(16, 20, 24)
		end
	end
end

function MainMenu:handleShopMessage(payload)
	if typeof(payload) ~= "table" then
		return
	end
	local message = if typeof(payload.message) == "string" then payload.message else ""
	if self.nicknameStatus then
		self.nicknameStatus.Text = message
		self.nicknameStatus.TextColor3 = if payload.ok then ACCENT else MUTED
	end
	if payload.reason == "filter_failed" and self.nicknameBox then
		self.nicknameBox.Text = self.nickname
	elseif payload.ok == true and self.nicknameBox and not self.nicknameBox:IsFocused() then
		self.nickname = trimNickname(self.nicknameBox.Text)
	end
end

function MainMenu:_refreshLockLabel()
	if not self.lockLabel then
		return
	end
	local lock = math.max((self.spectateUnlockAt or 0) - os.clock(), 0)
	self.social.spectateUnlockIn = lock
	if self.social.playing and lock &gt; 0 then
		self.lockLabel.Text = string.format("Spectate locked %.0fs", lock)
		self.spectateButton.Active = false
		self.spectateButton.AutoButtonColor = false
	else
		self.lockLabel.Text = if self.social.playing then "Spectate leaves the map and drops your mass."
			elseif typeof(self.social.spectateName) == "string" and self.social.spectateName ~= "" then "Watching " .. self.social.spectateName
			else "Spectating"
		self.spectateButton.Active = true
		self.spectateButton.AutoButtonColor = true
	end
end

function MainMenu:_refreshPlay()
	self:_refreshLockLabel()
end

function MainMenu:_personIsInMap(person): boolean
	return typeof(person) == "table" and person.playing == true
end

function MainMenu:_refreshSpawnNear()
	if not self.spawnNearToggle or not self.spawnTargetList then
		return
	end
	local on = self.social.spawnNearEnabled == true
	self.spawnNearToggle.Text = if on then "Spawn near: ON" else "Spawn near: OFF"
	self.spawnNearToggle.BackgroundColor3 = if on then ACCENT else Color3.fromRGB(200, 206, 214)

	local validUserIds = {}
	local partyHasInMap = false
	if self.social.party then
		for _, member in self.social.party.members or {} do
			if member.u ~= self.player.UserId and self:_personIsInMap(member) then
				validUserIds[member.u] = true
				partyHasInMap = true
			end
		end
	end
	for _, friend in self.social.friends or {} do
		if self:_personIsInMap(friend) then
			validUserIds[friend.u] = true
		end
	end
	if self.spawnMode == "user" and not validUserIds[self.spawnUserId] then
		self.spawnMode = "open"
		self.spawnUserId = nil
	elseif self.spawnMode == "party" and not partyHasInMap then
		self.spawnMode = "open"
		self.spawnUserId = nil
	end

	self:_clear(self.spawnTargetList)
	local function addTarget(text, mode, userId, selected)
		local b = button(self.spawnTargetList, text, if selected then ACCENT else Color3.fromRGB(200, 206, 214))
		b.Size = UDim2.new(1, 0, 0, 30)
		b.TextSize = 13
		if not selected then
			b.TextColor3 = Color3.fromRGB(20, 24, 28)
		end
		b.MouseButton1Click:Connect(function()
			self.spawnMode = mode
			self.spawnUserId = userId
			self:_refreshSpawnNear()
		end)
	end
	addTarget("Open space", "open", nil, self.spawnMode == "open")
	if partyHasInMap then
		addTarget("Anyone in my party", "party", nil, self.spawnMode == "party" and not self.spawnUserId)
		for _, member in self.social.party.members or {} do
			if member.u ~= self.player.UserId and self:_personIsInMap(member) then
				addTarget("Party: " .. (member.n or "Player"), "user", member.u, self.spawnMode == "user" and self.spawnUserId == member.u)
			end
		end
	end
	local listed = {}
	if self.social.party then
		for _, member in self.social.party.members or {} do
			listed[member.u] = true
		end
	end
	for _, friend in self.social.friends or {} do
		if not listed[friend.u] and self:_personIsInMap(friend) then
			addTarget("Friend: " .. (friend.n or "Player"), "user", friend.u, self.spawnMode == "user" and self.spawnUserId == friend.u)
		end
	end
end

function MainMenu:_refreshFriends()
	if not self.lists.server then
		return
	end
	self:_clear(self.lists.server)
	self:_clear(self.lists.incoming)
	self:_clear(self.lists.friends)
	local me = self.player.UserId
	local friendSet = {}
	for _, friend in self.social.friends or {} do
		friendSet[friend.u] = true
	end
	for _, person in self.social.serverPlayers or {} do
		if person.u ~= me then
			local actions = {}
			if friendSet[person.u] then
				actions[#actions + 1] = { "Invite", function()
					self:_fire({ action = "partyInvite", userId = person.u })
				end }
			else
				actions[#actions + 1] = { "Add", function()
					self:_fire({ action = "friendAdd", userId = person.u })
				end, ACCENT }
			end
			self:_row(self.lists.server, person.n or "Player", actions)
		end
	end
	for _, req in self.social.incoming or {} do
		self:_row(self.lists.incoming, (req.n or "Player") .. (req.kind == "party" and " (party)" or ""), {
			{ "Yes", function()
				self:_fire({ action = if req.kind == "party" then "partyAccept" else "friendAccept", userId = req.u })
			end },
			{ "No", function()
				self:_fire({ action = if req.kind == "party" then "partyDecline" else "friendDecline", userId = req.u })
			end, DANGER },
		})
	end
	for _, req in self.social.outgoing or {} do
		self:_row(self.lists.incoming, (req.n or "Player") .. " (sent)", {})
	end
	for _, friend in self.social.friends or {} do
		local tag = friend.n or "Player"
		if friend.online == false then
			tag ..= "  (offline)"
		elseif friend.playing then
			tag ..= "  (in map)"
		end
		self:_row(self.lists.friends, tag, {
			{ "Invite", function()
				self:_fire({ action = "partyInvite", userId = friend.u })
			end },
			{ "Unadd", function()
				self:_fire({ action = "friendRemove", userId = friend.u })
			end, DANGER },
		})
	end
end

function MainMenu:_refreshParty()
	if not self.lists.party then
		return
	end
	self:_clear(self.lists.party)
	local party = self.social.party
	if not party then
		self.partyInfo.Text = "Not in a party. Create one or join with a code."
		return
	end
	self.partyInfo.Text = "Code " .. tostring(party.code or "") .. "  ·  share this or invite friends"
	if self.codeBox and (self.codeBox.Text == "" or self.codeBox.Text == (party.code or "")) then
		self.codeBox.Text = party.code or ""
	end
	local meLeader = party.leader == self.player.UserId
	for _, member in party.members or {} do
		local actions = {}
		if meLeader and member.u ~= self.player.UserId then
			actions[#actions + 1] = { "Kick", function()
				self:_fire({ action = "partyKick", userId = member.u })
			end, DANGER }
		end
		local tag = member.n or "Player"
		if member.u == party.leader then
			tag ..= "  (leader)"
		end
		self:_row(self.lists.party, tag, actions)
	end
end

function MainMenu:_refreshSettings()
	if not self.bindButtons then
		return
	end
	for id, b in self.bindButtons do
		if self.capturingBind == id then
			b.Text = "Press a key..."
		else
			b.Text = keyName(self.keybinds[id])
		end
	end
	if self.minimapToggle then
		local on = self.minimapEnabled ~= false
		self.minimapToggle.Text = if on then "Minimap: ON" else "Minimap: OFF"
		self.minimapToggle.BackgroundColor3 = if on then ACCENT else Color3.fromRGB(200, 206, 214)
	end
	if self.mapLightButton then
		local selected = Color3.fromRGB(16, 20, 24)
		self.mapLightButton.BackgroundColor3 = if self.mapMode == "light" then ACCENT else MAP_LIGHT.bg
		self.mapLightButton.TextColor3 = if self.mapMode == "light" then selected else Color3.fromRGB(20, 24, 28)
		self.mapDarkButton.BackgroundColor3 = if self.mapMode == "dark" then ACCENT else MAP_DARK.bg
		self.mapDarkButton.TextColor3 = if self.mapMode == "dark" then selected else TEXT
		if self.mapMode == "custom" then
			self.mapPickerButton.BackgroundColor3 = ACCENT
			self.mapPickerButton.TextColor3 = selected
			self:_paintPicker()
		else
			self.mapPickerButton.BackgroundColor3 = Color3.fromRGB(200, 206, 214)
			self.mapPickerButton.TextColor3 = Color3.fromRGB(20, 24, 28)
		end
		if self.pickerFrame then
			self.pickerFrame.Visible = self.mapMode == "custom"
		end
	end
end

return MainMenu
