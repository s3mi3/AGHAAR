		debugPad.PaddingRight = UDim.new(0, 10)
		debugPad.Parent = debugButton

		debugButton.Activated:Connect(function()
			debugRemote:FireServer({ action = "toggle_world_resize" })
		end)
	end

	local skinShop = nil

