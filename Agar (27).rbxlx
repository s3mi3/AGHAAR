            <ProtectedString name="Source">local Config = {}

-- Start here when customizing the template. These values keep the current
-- gameplay feel by default; change them deliberately and test in Studio.
Config.World = {
	Size = Vector2.new(5600, 5600), -- compact arena; 20% shorter on each axis
	SpawnPadding = 220,
}

Config.DynamicWorld = {
	BasePlayers = 6,
	MaxScale = 1.75,
	ClusterPadding = 1050,
	ActiveCellMargin = 260,
	ShrinkDelaySeconds = 35,
	TargetHysteresis = 0.08,
	ExpandSpeed = 750,
	ShrinkSpeed = 120,
	SnapshotResizeStep = 180,
}

Config.Debug = {
	WorldResizeEnabled = false,
	WorldResizeTesterUserIds = {},
}

Config.UI = {
	ForcedScreenOrientation = Enum.ScreenOrientation.LandscapeRight,
}

Config.Persistence = {
	PlayerInfoDataStoreName = "PlayerInfo",
}

Config.Simulation = {
	Hz = 30,
	NetworkHz = 15,
	StaticNetworkHz = 2,
	StaticOverlapHz = 10,
	MaxFrameSteps = 4,
	SpatialCellSize = 160,
}

Config.Player = {
	MaxCells = 32,
	SpawnMass = 1000,
	InitialMass = 1000,
	MinDecayMass = 140,
	DecayPerSecond = 0.0004, -- was 0.001; slower shrink so mass sticks around
	HighMassDecayStartMass = 50000,
	HighMassDecayStartPerSecond = 500,
	HighMassDecayReferenceMass = 100000,
	HighMassDecayReferencePerSecond = 2000,
	BaseSpeed = 100,
	SmallCellMaxSpeed = 190, -- cap small pieces without slowing already-large cells
	MinSpeed = 75,
	SpeedExponent = 0.42,
	SpawnInvulnSeconds = 1.2,
	MovementDeadZone = 10,
	MovementDeadZoneRadiusScale = 0.35,
	MovementSlowDistance = 90,
	MovementSlowRadiusScale = 1.2,
	-- Split pieces should gather like Agar.io, not lock into a rigid
	-- formation and not vacuum into one point. SharedMultiCellSteering
	-- mixes a shared aim with a little per-cell homing (GatherBlend) and
	-- lets trailers catch up (GatherSpeedBlend). 0 blend = parallel only;
	-- 1 blend = the old everyone-homes-to-cursor clump.
	SharedMultiCellSteering = true,
	GatherBlend = 0.4,
	GatherSpeedBlend = 0.7,
	SpawnerBiasChance = 0.85,
	SpawnerBiasMinDistance = 240,
	SpawnerBiasMaxDistance = 760,
	SpawnerBiasAttempts = 12,
}

Config.Cell = {
	-- World-space radius. The old 0.632 scale made the displayed score
	-- substantially larger than the blob looked.
	RadiusScale = 0.78,
	MinEatRatio = 1.25,
	-- Pickup and spawner coverage. Enemy cells and viruses use the live
	-- EnemyEatOverlap deadzone below instead of requiring full containment.
	EatOverlap = 1,
	-- Live Eat Deadzone: lower = earlier consumption; higher = deeper coverage.
	-- 0 = target center crosses eater edge; 1 = full containment.
	-- Threshold = eater radius - target radius * deadzone, for enemies/viruses.
	-- Mass eligibility, pickup geometry and sibling merges stay separate.
	EnemyEatOverlap = 0.2,
	RecombineSeconds = 12, -- legacy fallback; see RecombineMin/Max below
	-- Mass-scaled recombine: small cells merge back quickly, big cells wait.
	-- Formula: clamp(Min + (mass / ScaleMass) * PerScaleMass, Min, Max).
	RecombineMinSeconds = 8,
	RecombineMaxSeconds = 10,
	MergePairInterval = 1.15, -- one local pair at a time per participating cell
	MergeFinalPairInterval = 1.65, -- slower final stages, not a single-tick vacuum
	SamePlayerPushSpeed = 720, -- resolve overlap instead of letting siblings sit inside each other
	SamePlayerPushStrength = 0.85,
	RecombineScaleMass = 10000,
	RecombinePerScaleMass = 2, -- seconds added per ScaleMass of mass
	SplitMinMass = 100,
	SplitImpulse = 300,
	SplitImpulseMassExponent = 0.28,
	MinSplitImpulseScale = 0.34, -- was 0.24; big-cell splits get real spread too
	SmallSplitReferenceMass = 1000,
	SmallSplitMinScale = 0.45,
	SplitInheritedBoostScale = 0.65,
	SplitMaxBoost = 500,
	SplitBoostDragPerSecond = 3,
	MaxSplitPiecesPerCommand = 16,
	-- Spawn close to the parent and let boost create the launch. Spawning two
	-- radii ahead caused authoritative collision before the visual got there.
	SplitSpawnOffsetRadiusScale = 0.35,
	-- Frozen splits stay motionless after spawning, but appear a small
	-- distance toward the cursor so the split still has direction.
	FrozenSplitNudgeRadiusScale = 0.55,
	FrozenSplitHeldBoostScale = 1,
	SplitConsumeGraceSeconds = 0.18,
	SplitPushGraceSeconds = 0.28,
	SplitPushMaxOverlapPerStep = 6,
	-- Client interpolation trails boosted cells slightly. Swept eating could
	-- therefore consume something the local blob had never visually reached.
	SweptEatingEnabled = false,
	SweptEatingMinBoostSpeed = 80,
	SweptEatingMinDistance = 6,
	SweptEatingMaxDistance = 160,
	SamePlayerPushPasses = 2,
	LoadSamePlayerPushPasses = 2,

	-- ==================================================================
	-- E repeats the normal Space split for every eligible cell twice.
	-- R repeats it three times.
	-- Set enabled = false to disable a hotkey without unbinding it.
	-- ==================================================================
	DoubleSplitEnabled = true,
	TripleSplitEnabled = true,
	RSplitGenerations = 3,
	ESplitGenerations = 2,

	-- Cluster matching was making split pieces travel as one blob.
	-- Agar.io lets each cell keep its own mass-based speed, so small
	-- pieces pull ahead while big ones lag. Ratio &lt;= 1 disables the cap.
	-- CohesionStrength (0..1) would pull toward the group centroid;
	-- 0 keeps independent steering with no inward tether.
	ClusterMaxSpeedRatio = 0,
	CohesionStrength = 0, -- no automatic inward pull; preserve player-directed spacing
	ClusterFreeDistance = 260,
	ClusterFreeRadiusScale = 3,
	ClusterOutwardBraking = 0, -- no tether slowing pieces away from the group

	-- Splits aim directly from each source cell at the cursor.
	SplitGroupFanRadians = 0,
	MultiSplitFanRadians = 0,
	MultiSplitStaggerRadiusScale = 0.18,

	-- ==================================================================
	-- CANNIBALIZE (AUTOMATIC): a bigger own-cell will automatically
	-- engulf a smaller sibling cell BEFORE the normal recombine timer
	-- elapses when the bigger cell physically rolls over the smaller
	-- one. No keybind required.
	--
	-- Tuning goal: cannibalize must NOT replace the normal merge
	-- system. The mass-scaled recombine window is ~1.7s (small) to
	-- ~5s (max mass), so cannibalize is deliberately tuned to require
	-- a bigger size gap AND to activate past the top of that window,
	-- so similar-sized siblings always merge instead of being eaten.
	--
	-- Guards:
	--   * Target must be at least CannibalizeSecondsSinceSplit old
	--     (5s — matches the recombine cap so normal merges fire first).
	--   * Eater must be CannibalizeMassRatio× (4x) the target's mass —
	--     equal-sized siblings never eat each other; only clearly
	--     dominant cells cannibalize scraps.
	--   * Target's CENTER must be inside eater's disc (minus
	--     CannibalizeOverlap * targetRadius) — grazing contact is
	--     NOT enough, you must actually cover it.
	-- Set CannibalizeEnabled = false to turn the mechanic off entirely.
	-- ==================================================================
	CannibalizeEnabled = true,
	CannibalizeSecondsSinceSplit = 10,
	CannibalizeMassRatio = 4.0,         -- was 2.0; require a real size gap
	CannibalizeOverlap = 0.85,
}

-- Shared by authoritative movement and local prediction to avoid speed drift.
function Config.moveSpeedForMass(mass: number): number
	local player = Config.Player
	local speed = player.BaseSpeed * (player.InitialMass / math.max(mass, 1)) ^ player.SpeedExponent
	-- SmallCellMaxSpeed is the ceiling for tiny pieces. Using math.min with
	-- BaseSpeed previously forced every cell to the same top speed, so a
	-- split blob crawled as one rigid pack instead of stretching out.
	local maximum = math.max(player.SmallCellMaxSpeed or player.BaseSpeed, player.BaseSpeed)
	return math.clamp(speed, math.min(player.MinSpeed, maximum), maximum)
end

function Config.clusterCappedMoveSpeed(speed: number, biggestCellSpeed: number?): number
	local ratio = Config.Cell.ClusterMaxSpeedRatio
	if not biggestCellSpeed or typeof(ratio) ~= "number" or ratio &lt;= 1 then
		return speed
	end
	return math.min(speed, biggestCellSpeed * ratio)
end

-- One steering rule for server sim and client prediction.
-- One cell: classic homing toward the cursor, with a per-cell deadzone.
-- Multiple cells: mostly shared aim so the blob does not vacuum into the
-- cursor, plus a little per-cell homing and trailer catch-up so pieces
-- naturally gather. Nearby small outliers can still close on each other
-- and merge as a pair before the big cell arrives.
function Config.moveVector(target: Vector2?, aim: Vector2?, pos: Vector2, radius: number, origin: Vector2?, ownCellCount: number)
	local fallbackAim = Vector2.new(1, 0)
	if typeof(aim) == "Vector2" and aim.Magnitude &gt; 0.001 then
		fallbackAim = aim.Unit
	end
	if typeof(target) ~= "Vector2" then
		return fallbackAim, 1
	end

	local homeOffset = target - pos
	local homeDist = homeOffset.Magnitude
	local singleCell = (ownCellCount or 1) &lt;= 1 or Config.Player.SharedMultiCellSteering == false
	if singleCell then
		local deadZone = math.max(
			Config.Player.MovementDeadZone or 10,
			radius * (Config.Player.MovementDeadZoneRadiusScale or 0)
		)
		if homeDist &lt;= deadZone then
			return Vector2.zero, 0
		end
		local slowDistance = math.max(
			Config.Player.MovementSlowDistance or 90,
			radius * (Config.Player.MovementSlowRadiusScale or 0)
		)
		local speedScale = math.clamp((homeDist - deadZone) / slowDistance, 0, 1)
		if speedScale &lt; 0.02 then
			return Vector2.zero, 0
		end
		return homeOffset / homeDist, speedScale
	end

	local groupOrigin = if typeof(origin) == "Vector2" then origin else pos
	local groupOffset = target - groupOrigin
	local groupDist = groupOffset.Magnitude
	local deadZone = math.max(Config.Player.MovementDeadZone or 10, 0)
	local slowDistance = math.max(Config.Player.MovementSlowDistance or 90, 1)
	local function scaleFor(distance: number): number
		if distance &lt;= deadZone then
			return 0
		end
		local scale = math.clamp((distance - deadZone) / slowDistance, 0, 1)
		if scale &lt; 0.02 then
			return 0
		end
		return scale
	end

	local speedBlend = math.clamp(Config.Player.GatherSpeedBlend or 0.7, 0, 1)
	local speedScale = scaleFor(homeDist) * speedBlend + scaleFor(groupDist) * (1 - speedBlend)
	if speedScale &lt; 0.02 then
		return Vector2.zero, 0
	end

	local sharedDir = fallbackAim
	if groupDist &gt; 0.001 then
		sharedDir = groupOffset / groupDist
	end
	if typeof(aim) == "Vector2" and aim.Magnitude &gt; 0.001 then
		sharedDir = aim.Unit
	end
	local homeDir = if homeDist &gt; 0.001 then homeOffset / homeDist else sharedDir
	local gather = math.clamp(Config.Player.GatherBlend or 0.4, 0, 1)
	local mixed = sharedDir:Lerp(homeDir, gather)
	if mixed.Magnitude &gt; 0.001 then
		return mixed.Unit, speedScale
	end
	return sharedDir, speedScale
end

function Config.smallCellSplitScale(mass: number): number
	local reference = math.max(Config.Cell.SmallSplitReferenceMass or Config.Player.InitialMass, 1)
	return math.clamp(math.sqrt(math.max(mass, 1) / reference),
		math.clamp(Config.Cell.SmallSplitMinScale or 0.45, 0.1, 1), 1)
end

-- Shared steering: leave normal spacing and split momentum alone. Only
-- distant pieces receive a gradual inward pull and outward steering brake.
function Config.balanceClusterVelocity(pos: Vector2, center: Vector2?, groupRadius: number, velocity: Vector2, speed: number): Vector2
	local strength = math.clamp(Config.Cell.CohesionStrength or 0, 0, 1)
	if not center or strength &lt;= 0 then return velocity end
	local offset = pos - center
	local distance = offset.Magnitude
	local slack = math.max(Config.Cell.ClusterFreeDistance or 260,
		groupRadius * (Config.Cell.ClusterFreeRadiusScale or 3), 1)
	if distance &lt;= slack then return velocity end
	local outward = offset / distance
	local t = math.clamp((distance - slack) / slack, 0, 1)
	local weight = t * t * (3 - 2 * t)
	local brake = math.clamp(Config.Cell.ClusterOutwardBraking or 0.85, 0, 1)
	local outwardSpeed = math.max(velocity:Dot(outward), 0)
	return velocity - outward * (outwardSpeed * brake * weight + speed * strength * weight)
end

