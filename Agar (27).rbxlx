		coins = "Coins",
		score = "Score",
		ping = "Ping",
		level = "Lv",
		map_auto = "Map Auto",
		map_resize = "Map 2x",
	},
	es = {
		shop_open = "Aspectos",
		shop_title = "Aspectos",
		nickname_placeholder = "Date un nombre",
