function MainMenu:_buildSettingsPage()
	local page = self:_page("settings")
	local left = Instance.new("ScrollingFrame")
	left.BackgroundTransparency = 1
	left.Size = UDim2.new(0.48, 0, 1, 0)
	left.ScrollBarThickness = 6
	left.AutomaticCanvasSize = Enum.AutomaticSize.Y
	left.CanvasSize = UDim2.fromOffset(0, 0)
	left.Parent = page
	local leftLayout = Instance.new("UIListLayout")
	leftLayout.Padding = UDim.new(0, 8)
	leftLayout.Parent = left

	label(left, "Map colour", 16, TEXT, true).Size = UDim2.new(1, 0, 0, 22)

	self.mapLightButton = button(left, "Light", MAP_LIGHT.bg)
	self.mapLightButton.Size = UDim2.new(1, 0, 0, 32)
	self.mapLightButton.MouseButton1Click:Connect(function()
		self.mapMode = "light"
		self:_applyMapColor(MAP_LIGHT.bg, MAP_LIGHT.grid, true)
		self:_refreshSettings()
	end)

	self.mapDarkButton = button(left, "Dark", MAP_DARK.bg)
	self.mapDarkButton.Size = UDim2.new(1, 0, 0, 32)
	self.mapDarkButton.TextColor3 = TEXT
	self.mapDarkButton.MouseButton1Click:Connect(function()
		self.mapMode = "dark"
		self:_applyMapColor(MAP_DARK.bg, MAP_DARK.grid, true)
		self:_refreshSettings()
	end)

	self.mapPickerButton = button(left, "Colour picker", Color3.fromRGB(200, 206, 214))
	self.mapPickerButton.Size = UDim2.new(1, 0, 0, 32)
	self.mapPickerButton.MouseButton1Click:Connect(function()
		self.mapMode = "custom"
		local h, s, v = self.mapColor:ToHSV()
		self.pickerH, self.pickerS, self.pickerV = h, s, v
		self:_paintPicker()
		if self.pickerFrame then
			self.pickerFrame.Visible = true
		end
		self:_refreshSettings()
	end)

	self:_buildColourPicker(left)

	local right = Instance.new("ScrollingFrame")
	right.BackgroundTransparency = 1
	right.Position = UDim2.new(0.52, 0, 0, 0)
	right.Size = UDim2.new(0.48, 0, 1, 0)
	right.ScrollBarThickness = 6
	right.AutomaticCanvasSize = Enum.AutomaticSize.Y
	right.CanvasSize = UDim2.fromOffset(0, 0)
	right.Parent = page
	local rightLayout = Instance.new("UIListLayout")
	rightLayout.Padding = UDim.new(0, 8)
	rightLayout.Parent = right

	label(right, "Keybinds", 16, TEXT, true).Size = UDim2.new(1, 0, 0, 22)
	self.bindButtons = {}
	for _, entry in BIND_ORDER do
		local row = Instance.new("Frame")
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 36)
		row.Parent = right
		local name = label(row, entry.label, 14, TEXT, false)
		name.Size = UDim2.new(0.5, 0, 1, 0)
		local b = button(row, keyName(self.keybinds[entry.id]), Color3.fromRGB(200, 206, 214))
		b.Position = UDim2.new(0.5, 0, 0, 0)
		b.Size = UDim2.new(0.5, 0, 1, 0)
		b.MouseButton1Click:Connect(function()
			self.capturingBind = entry.id
			b.Text = "Press a key..."
		end)
		self.bindButtons[entry.id] = b
	end

	label(right, "HUD", 16, TEXT, true).Size = UDim2.new(1, 0, 0, 22)

	self.minimapToggle = button(right, "Minimap: ON", ACCENT)
	self.minimapToggle.Size = UDim2.new(1, 0, 0, 40)
	self.minimapToggle.MouseButton1Click:Connect(function()
		self.minimapEnabled = self.minimapEnabled ~= true
		if self.renderer and self.renderer.setMinimapEnabled then
			self.renderer:setMinimapEnabled(self.minimapEnabled)
		end
		self:_fire({ action = "settings", minimapEnabled = self.minimapEnabled == true })
		self:_refreshSettings()
	end)

	self.settingsEditHudButton = button(right, "Move &amp; resize HUD", Color3.fromRGB(200, 206, 214))
	self.settingsEditHudButton.Size = UDim2.new(1, 0, 0, 40)
	self.settingsEditHudButton.MouseButton1Click:Connect(function()
		self:_beginHudEdit()
	end)

	self.resetHudButton = button(right, "Reset HUD layout", Color3.fromRGB(200, 206, 214))
	self.resetHudButton.Size = UDim2.new(1, 0, 0, 40)
	self.resetHudButton.MouseButton1Click:Connect(function()
		self:_resetHudLayout()
	end)
end

function MainMenu:_buildColourPicker(parent)
	local frame = Instance.new("Frame")
	frame.Name = "ColourPicker"
	frame.BackgroundColor3 = PANEL2
	frame.BorderSizePixel = 0
	frame.Size = UDim2.new(1, 0, 0, 214)
	frame.Visible = false
	frame.Parent = parent
	corner(frame, 8)
	self.pickerFrame = frame

	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.PaddingBottom = UDim.new(0, 10)
	pad.Parent = frame

	local sv = Instance.new("TextButton")
	sv.Name = "SV"
	sv.AutoButtonColor = false
	sv.BorderSizePixel = 0
	sv.Position = UDim2.fromOffset(0, 0)
	sv.Size = UDim2.new(1, 0, 0, 132)
	sv.Text = ""
	sv.Parent = frame
	corner(sv, 6)
	self.pickerSV = sv

	local white = Instance.new("Frame")
	white.BackgroundColor3 = Color3.new(1, 1, 1)
	white.BorderSizePixel = 0
	white.Size = UDim2.fromScale(1, 1)
	white.ZIndex = 2
	white.Parent = sv
	local whiteGrad = Instance.new("UIGradient")
	whiteGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(1, 1),
	})
	whiteGrad.Parent = white
	local whiteCorner = Instance.new("UICorner")
	whiteCorner.CornerRadius = UDim.new(0, 6)
	whiteCorner.Parent = white

	local black = Instance.new("Frame")
	black.BackgroundColor3 = Color3.new(0, 0, 0)
	black.BorderSizePixel = 0
	black.Size = UDim2.fromScale(1, 1)
	black.ZIndex = 3
	black.Parent = sv
	local blackGrad = Instance.new("UIGradient")
	blackGrad.Rotation = 90
	blackGrad.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(1, 0),
	})
	blackGrad.Parent = black
	local blackCorner = Instance.new("UICorner")
	blackCorner.CornerRadius = UDim.new(0, 6)
	blackCorner.Parent = black

	local svCursor = Instance.new("Frame")
	svCursor.AnchorPoint = Vector2.new(0.5, 0.5)
	svCursor.BackgroundColor3 = Color3.new(1, 1, 1)
	svCursor.BorderSizePixel = 0
	svCursor.Size = UDim2.fromOffset(12, 12)
	svCursor.ZIndex = 4
	svCursor.Parent = sv
	corner(svCursor, 6)
	local svStroke = Instance.new("UIStroke")
	svStroke.Color = Color3.new(0, 0, 0)
	svStroke.Thickness = 1
	svStroke.Parent = svCursor
	self.pickerSVCursor = svCursor

	local hue = Instance.new("TextButton")
	hue.Name = "Hue"
	hue.AutoButtonColor = false
	hue.BorderSizePixel = 0
	hue.Position = UDim2.fromOffset(0, 140)
	hue.Size = UDim2.new(1, 0, 0, 16)
	hue.Text = ""
	hue.Parent = frame
	corner(hue, 6)
	local hueGrad = Instance.new("UIGradient")
	hueGrad.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
		ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
		ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
		ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
		ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
	})
	hueGrad.Parent = hue
	self.pickerHue = hue

	local hueCursor = Instance.new("Frame")
	hueCursor.AnchorPoint = Vector2.new(0.5, 0.5)
	hueCursor.BackgroundColor3 = Color3.new(1, 1, 1)
	hueCursor.BorderSizePixel = 0
	hueCursor.Position = UDim2.fromScale(0, 0.5)
	hueCursor.Size = UDim2.fromOffset(8, 18)
	hueCursor.ZIndex = 4
	hueCursor.Parent = hue
	corner(hueCursor, 3)
	local hueStroke = Instance.new("UIStroke")
	hueStroke.Color = Color3.new(0, 0, 0)
	hueStroke.Thickness = 1
	hueStroke.Parent = hueCursor
	self.pickerHueCursor = hueCursor

	local preview = Instance.new("Frame")
	preview.BorderSizePixel = 0
	preview.Position = UDim2.fromOffset(0, 164)
	preview.Size = UDim2.new(1, 0, 0, 28)
	preview.Parent = frame
	corner(preview, 6)
	self.pickerPreview = preview

	sv.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			self.pickerDrag = "sv"
			self:_updatePickerFromInput(input)
		end
	end)
	hue.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			self.pickerDrag = "hue"
			self:_updatePickerFromInput(input)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if self.pickerDrag and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			self:_updatePickerFromInput(input)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if self.pickerDrag and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
			self:_updatePickerFromInput(input)
			self.pickerDrag = nil
			self:_applyPicker(true)
		end
	end)

	self:_paintPicker()
end

function MainMenu:_paintPicker()
	if not self.pickerSV then
		return
	end
	self.pickerSV.BackgroundColor3 = Color3.fromHSV(self.pickerH, 1, 1)
	self.pickerSVCursor.Position = UDim2.fromScale(self.pickerS, 1 - self.pickerV)
	self.pickerHueCursor.Position = UDim2.fromScale(self.pickerH, 0.5)
	local color = Color3.fromHSV(self.pickerH, self.pickerS, self.pickerV)
	self.pickerPreview.BackgroundColor3 = color
	if self.mapPickerButton then
		self.mapPickerButton.BackgroundColor3 = color
		local luma = color.R * 0.25 + color.G * 0.5 + color.B * 0.25
		self.mapPickerButton.TextColor3 = if luma &lt; 0.45 then TEXT else Color3.fromRGB(16, 20, 24)
	end
end

function MainMenu:_applyPicker(save)
	local bg = Color3.fromHSV(self.pickerH, self.pickerS, self.pickerV)
	self:_applyMapColor(bg, gridFromBackground(bg), save == true)
	self:_paintPicker()
end

function MainMenu:_updatePickerFromInput(input)
	if self.pickerDrag == "hue" and self.pickerHue then
		local x = pointer01(self.pickerHue, input)
		self.pickerH = x
		self.mapMode = "custom"
		self:_applyPicker(false)
	elseif self.pickerDrag == "sv" and self.pickerSV then
		local x, y = pointer01(self.pickerSV, input)
		self.pickerS = x
		self.pickerV = 1 - y
		self.mapMode = "custom"
		self:_applyPicker(false)
	end
end

function MainMenu:_makeList(parent, title, size, pos)
	local frame = Instance.new("Frame")
	frame.BackgroundColor3 = PANEL2
	frame.BorderSizePixel = 0
	frame.Position = pos
	frame.Size = size
	frame.Parent = parent
	corner(frame, 8)
	local t = label(frame, title, 14, MUTED, true)
	t.Position = UDim2.fromOffset(10, 6)
	t.Size = UDim2.new(1, -16, 0, 20)
	local scroll = Instance.new("ScrollingFrame")
	scroll.BackgroundTransparency = 1
	scroll.Position = UDim2.fromOffset(0, 28)
	scroll.Size = UDim2.new(1, 0, 1, -28)
	scroll.ScrollBarThickness = 5
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.fromOffset(0, 0)
	scroll.Parent = frame
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.Parent = scroll
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0, 8)
	pad.PaddingRight = UDim.new(0, 8)
	pad.Parent = scroll
	return scroll
end

function MainMenu:_clear(scroll)
	for _, child in scroll:GetChildren() do
		if child:IsA("TextButton") or child:IsA("Frame") then
			child:Destroy()
		end
	end
end

function MainMenu:_row(parent, text, actions)
	local row = Instance.new("Frame")
	row.BackgroundTransparency = 1
	row.Size = UDim2.new(1, 0, 0, 32)
	row.Parent = parent
	local l = label(row, text, 13, TEXT, false)
	l.Size = UDim2.new(1, -120, 1, 0)
	l.TextTruncate = Enum.TextTruncate.AtEnd
	local x = 1
	for i = #actions, 1, -1 do
		local action = actions[i]
		local b = button(row, action[1], action[3] or ACCENT)
		b.AnchorPoint = Vector2.new(1, 0.5)
		b.Position = UDim2.new(1, -(i - 1) * 58, 0.5, 0)
		b.Size = UDim2.fromOffset(54, 24)
		b.TextSize = 11
		if action[3] == DANGER then
			b.TextColor3 = TEXT
		end
		b.MouseButton1Click:Connect(action[2])
	end
	return row
end

