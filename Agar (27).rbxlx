            <ProtectedString name="Source">local SkinData = {}

-- Template skin registry.
--
-- Add, remove, or reorder entries in OrderedSkins to control the shop.
-- Required fields:
--   id: unique string saved in DataStores, so avoid changing it after publish.
--   name: player-facing name shown in the shop.
--   cost: coin price.
--   image: Roblox image/decal asset id, for example "rbxassetid://123456789".
-- Optional atlas fields:
--   imageRectOffset = Vector2.new(x, y)
--   imageRectSize = Vector2.new(width, height)
