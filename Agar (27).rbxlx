            <ProtectedString name="Source">local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage:WaitForChild("Agar2D"):WaitForChild("Shared"):WaitForChild("Config"))

local MainMenu = {}
MainMenu.__index = MainMenu

local ACCENT = Color3.fromRGB(88, 214, 90)
local PANEL = Color3.fromRGB(18, 22, 28)
local PANEL2 = Color3.fromRGB(28, 34, 42)
local TEXT = Color3.fromRGB(240, 244, 248)
local MUTED = Color3.fromRGB(160, 170, 182)
local DANGER = Color3.fromRGB(232, 86, 86)

local DEFAULT_BINDS = {
	split = Enum.KeyCode.Space,
	feed = Enum.KeyCode.W,
	freeze = Enum.KeyCode.F,
	doubleSplit = Enum.KeyCode.R,
	tripleSplit = Enum.KeyCode.E,
	menu = Enum.KeyCode.M,
}

local BIND_ORDER = {
	{ id = "menu", label = "Main Menu" },
	{ id = "split", label = "Split" },
	{ id = "feed", label = "Feed" },
	{ id = "freeze", label = "Freeze" },
	{ id = "doubleSplit", label = "Triple Split" },
	{ id = "tripleSplit", label = "Double Split" },
}

local MAP_LIGHT = {
	bg = Color3.fromRGB(247, 247, 247),
	grid = Color3.fromRGB(218, 225, 235),
}
local MAP_DARK = {
	bg = Color3.fromRGB(18, 22, 28),
	grid = Color3.fromRGB(42, 50, 62),
}

local function gridFromBackground(bg: Color3): Color3
	local h, s, v = bg:ToHSV()
	if v &gt; 0.55 then
		return Color3.fromHSV(h, math.clamp(s * 0.5, 0, 1), math.clamp(v * 0.86, 0.2, 1))
	end
	return Color3.fromHSV(h, math.clamp(s * 0.55, 0, 1), math.clamp(v + 0.18, 0, 0.85))
end

local function colorsClose(a: Color3, b: Color3): boolean
	return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) &lt; 0.05
end

local function pointer01(gui, input): (number, number)
	local pos = input.Position
	local abs = gui.AbsolutePosition
	local size = gui.AbsoluteSize
	local x = math.clamp((pos.X - abs.X) / math.max(size.X, 1), 0, 1)
	local y = math.clamp((pos.Y - abs.Y) / math.max(size.Y, 1), 0, 1)
	return x, y
end

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 8)
	c.Parent = parent
	return c
end

local function label(parent, text, size, color, bold)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Font = if bold then Enum.Font.GothamBold else Enum.Font.GothamMedium
	l.Text = text
	l.TextColor3 = color or TEXT
	l.TextSize = size or 16
	l.TextXAlignment = Enum.TextXAlignment.Left
	l.Parent = parent
	return l
end

local function button(parent, text, color)
	local b = Instance.new("TextButton")
	b.AutoButtonColor = true
	b.BackgroundColor3 = color or ACCENT
	b.BorderSizePixel = 0
	b.Font = Enum.Font.GothamBold
	b.Text = text
	b.TextColor3 = Color3.fromRGB(16, 20, 24)
	b.TextSize = 15
	b.Parent = parent
	corner(b, 8)
	return b
end

local function keyName(code)
	if typeof(code) ~= "EnumItem" then
		return "?"
	end
	if code == Enum.KeyCode.Space then
		return "Space"
	end
	return code.Name
end

local function parseKey(name)
	if typeof(name) ~= "string" or name == "" then
		return nil
	end
	local ok, value = pcall(function()
		return Enum.KeyCode[name]
	end)
	if ok and typeof(value) == "EnumItem" then
		return value
	end
	return nil
end

local AVATAR_MODES = {
	{ mode = "fullBody", label = "Full body", thumb = Enum.ThumbnailType.AvatarThumbnail, scale = Enum.ScaleType.Fit },
	{ mode = "bust", label = "Bust", thumb = Enum.ThumbnailType.AvatarBust, scale = Enum.ScaleType.Fit },
	{ mode = "face", label = "Face", thumb = Enum.ThumbnailType.HeadShot, scale = Enum.ScaleType.Crop },
}

local function trimNickname(value)
	if typeof(value) ~= "string" then
		return ""
	end
	value = value:gsub("[%c]", " ")
	value = value:gsub("^%s+", ""):gsub("%s+$", "")
	value = value:gsub("%s+", " ")
	if #value &gt; 20 then
		value = string.sub(value, 1, 20)
	end
	return value
end

function MainMenu.new(playerGui, remotes, renderer, input, camera)
	local gui = Instance.new("ScreenGui")
	gui.Name = "AgarMainMenu"
	gui.IgnoreGuiInset = true
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 80
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	local dim = Instance.new("Frame")
	dim.Name = "Dim"
	dim.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	dim.BackgroundTransparency = 0.35
	dim.BorderSizePixel = 0
	dim.Size = UDim2.fromScale(1, 1)
	dim.ZIndex = 1
	dim.Parent = gui

	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.BackgroundColor3 = PANEL
	panel.BorderSizePixel = 0
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.fromOffset(760, 520)
	panel.ZIndex = 2
	panel.Parent = gui
	corner(panel, 16)

	local title = label(panel, "agarZ.io", 28, ACCENT, true)
	title.Position = UDim2.fromOffset(24, 16)
	title.Size = UDim2.fromOffset(180, 34)

	local subtitle = label(panel, "Press M to open or close anytime", 13, MUTED, false)
	subtitle.Position = UDim2.fromOffset(24, 50)
	subtitle.Size = UDim2.fromOffset(320, 18)

	local nicknameBox = Instance.new("TextBox")
	nicknameBox.Name = "Nickname"
	nicknameBox.AnchorPoint = Vector2.new(1, 0)
	nicknameBox.BackgroundColor3 = PANEL2
	nicknameBox.BorderSizePixel = 0
	nicknameBox.ClearTextOnFocus = false
	nicknameBox.Font = Enum.Font.GothamMedium
	nicknameBox.PlaceholderColor3 = MUTED
	nicknameBox.PlaceholderText = "Give yourself a name"
	nicknameBox.Position = UDim2.new(1, -24, 0, 16)
	nicknameBox.Size = UDim2.fromOffset(280, 34)
	nicknameBox.Text = ""
	nicknameBox.TextColor3 = TEXT
	nicknameBox.TextSize = 15
	nicknameBox.TextXAlignment = Enum.TextXAlignment.Left
	nicknameBox.ZIndex = 4
	nicknameBox.Parent = panel
	corner(nicknameBox, 8)
	local nicknamePad = Instance.new("UIPadding")
	nicknamePad.PaddingLeft = UDim.new(0, 12)
	nicknamePad.PaddingRight = UDim.new(0, 12)
	nicknamePad.Parent = nicknameBox

	local nicknameStatus = label(panel, "", 12, MUTED, false)
	nicknameStatus.AnchorPoint = Vector2.new(1, 0)
	nicknameStatus.Position = UDim2.new(1, -24, 0, 50)
	nicknameStatus.Size = UDim2.fromOffset(280, 18)
	nicknameStatus.TextXAlignment = Enum.TextXAlignment.Right

	local tabs = Instance.new("Frame")
	tabs.BackgroundTransparency = 1
	tabs.Position = UDim2.fromOffset(24, 78)
	tabs.Size = UDim2.new(1, -48, 0, 34)
	tabs.ZIndex = 3
	tabs.Parent = panel

	local pages = Instance.new("Frame")
	pages.BackgroundTransparency = 1
	pages.Position = UDim2.fromOffset(24, 122)
	pages.Size = UDim2.new(1, -48, 1, -146)
	pages.ZIndex = 3
	pages.Parent = panel

	local self = setmetatable({
		gui = gui,
		dim = dim,
		panel = panel,
		pages = pages,
		tabButtons = {},
		pageFrames = {},
		open = true,
		tab = "play",
		renderer = renderer,
		input = input,
		camera = camera,
		remote = remotes.SocialAction,
		updateRemote = remotes.SocialUpdate,
		shopRemote = remotes.ShopAction,
		player = Players.LocalPlayer,
		nickname = "",
		avatarDisplayMode = "face",
		skinPreviews = {},
		social = {
			playing = false,
			spectating = false,
			spectateName = "",
			spectateUnlockIn = 0,
			spawnNearEnabled = true,
			friends = {},
			incoming = {},
			outgoing = {},
			serverPlayers = {},
			party = nil,
			leaders = {},
			mapPlayers = {},
		},
		keybinds = table.clone(DEFAULT_BINDS),
		capturingBind = nil,
		spawnMode = "open",
		spawnUserId = nil,
		spectateUnlockAt = 0,
		mapColor = MAP_LIGHT.bg,
		gridColor = MAP_LIGHT.grid,
		mapMode = "light",
		pickerH = 0.38,
		pickerS = 0.35,
		pickerV = 0.95,
		pickerDrag = nil,
		minimapEnabled = true,
		hudLayout = {},
		hudEditing = false,
		nicknameBox = nicknameBox,
		nicknameStatus = nicknameStatus,
		statusLabel = nil,
		lockLabel = nil,
		codeBox = nil,
		joinBox = nil,
		lists = {},
	}, MainMenu)

	self:_buildTabs(tabs)
	self:_buildPlayPage()
	self:_buildSkinsPage()
	self:_buildFriendsPage()
	self:_buildPartyPage()
	self:_buildSettingsPage()
	self:_buildHudEditBar()
	self:_showTab("play")
	self:_bindInput()
	nicknameBox.FocusLost:Connect(function()
		self:_saveNickname()
	end)

	if self.updateRemote then
		self.updateRemote.OnClientEvent:Connect(function(payload)
			self:handleUpdate(payload)
		end)
	end

	self:setOpen(true)
	RunService.Heartbeat:Connect(function()
		if self.social.playing and (self.spectateUnlockAt or 0) &gt; os.clock() then
			self:_refreshLockLabel()
		end
	end)
	return self
end

function MainMenu:_buildTabs(parent)
	local order = {
		{ "Play", "play" },
		{ "Skins", "skins" },
		{ "Friends", "friends" },
		{ "Party", "party" },
		{ "Settings", "settings" },
	}
	for index, entry in order do
		local b = Instance.new("TextButton")
		b.AutoButtonColor = true
		b.BackgroundColor3 = PANEL2
		b.BorderSizePixel = 0
		b.Font = Enum.Font.GothamBold
		b.Position = UDim2.fromOffset((index - 1) * 110, 0)
		b.Size = UDim2.fromOffset(104, 34)
		b.Text = entry[1]
		b.TextColor3 = TEXT
		b.TextSize = 14
		b.ZIndex = 4
		b.Parent = parent
		corner(b, 8)
		b.MouseButton1Click:Connect(function()
			self:_showTab(entry[2])
		end)
		self.tabButtons[entry[2]] = b
	end
end

function MainMenu:_page(name)
	local page = Instance.new("Frame")
	page.Name = name
	page.BackgroundTransparency = 1
	page.Size = UDim2.fromScale(1, 1)
	page.Visible = false
	page.ZIndex = 3
	page.Parent = self.pages
	self.pageFrames[name] = page
	return page
end

function MainMenu:_showTab(name)
	self.tab = name
	for id, page in self.pageFrames do
		page.Visible = id == name
	end
	for id, b in self.tabButtons do
		b.BackgroundColor3 = if id == name then ACCENT else PANEL2
		b.TextColor3 = if id == name then Color3.fromRGB(16, 20, 24) else TEXT
	end
	self:_refreshAll()
end

function MainMenu:_buildPlayPage()
	local page = self:_page("play")

	local play = button(page, "Play", ACCENT)
	play.Position = UDim2.fromOffset(0, 0)
	play.Size = UDim2.fromOffset(180, 44)
	play.MouseButton1Click:Connect(function()
		self:_play()
	end)

	local spectate = button(page, "Spectate", Color3.fromRGB(200, 206, 214))
	spectate.Position = UDim2.fromOffset(196, 0)
	spectate.Size = UDim2.fromOffset(160, 44)
	spectate.MouseButton1Click:Connect(function()
		self:_fire({ action = "spectate" })
	end)
	self.spectateButton = spectate

	self.lockLabel = label(page, "", 14, DANGER, false)
	self.lockLabel.Position = UDim2.fromOffset(372, 8)
	self.lockLabel.Size = UDim2.fromOffset(300, 28)

	self.playEditHudButton = button(page, "Move &amp; resize HUD", Color3.fromRGB(200, 206, 214))
	self.playEditHudButton.Position = UDim2.fromOffset(0, 56)
	self.playEditHudButton.Size = UDim2.fromOffset(220, 40)
	self.playEditHudButton.MouseButton1Click:Connect(function()
		self:_beginHudEdit()
	end)

	self.statusLabel = label(page, "", 14, MUTED, false)
	self.statusLabel.Position = UDim2.fromOffset(0, 108)
	self.statusLabel.Size = UDim2.new(1, 0, 0, 36)
	self.statusLabel.TextWrapped = true
end

function MainMenu:_buildSkinsPage()
	local page = self:_page("skins")

	local coming = label(page, "Coming soon", 28, ACCENT, true)
	coming.Size = UDim2.new(1, 0, 0, 34)
	coming.TextXAlignment = Enum.TextXAlignment.Center

	local hint = label(page, "Skins are not available yet. Pick how your avatar sits on your cell.", 14, MUTED, false)
	hint.Position = UDim2.fromOffset(0, 38)
	hint.Size = UDim2.new(1, 0, 0, 22)
	hint.TextXAlignment = Enum.TextXAlignment.Center

	local previews = Instance.new("Frame")
	previews.BackgroundTransparency = 1
	previews.Position = UDim2.fromOffset(0, 78)
	previews.Size = UDim2.new(1, 0, 0, 230)
	previews.ZIndex = 4
	previews.Parent = page

	self.skinPreviews = {}
	local count = #AVATAR_MODES
	for index, info in AVATAR_MODES do
		local card = Instance.new("TextButton")
		card.AutoButtonColor = false
		card.BackgroundTransparency = 1
		card.Position = UDim2.new((index - 1) / count, 8, 0, 0)
		card.Size = UDim2.new(1 / count, -16, 1, 0)
		card.Text = ""
		card.ZIndex = 4
		card.Parent = previews

		local cell = Instance.new("Frame")
		cell.AnchorPoint = Vector2.new(0.5, 0)
		cell.BackgroundColor3 = Color3.fromRGB(80, 150, 240)
		cell.BorderSizePixel = 0
		cell.Position = UDim2.new(0.5, 0, 0, 8)
		cell.Size = UDim2.fromOffset(148, 148)
		cell.ZIndex = 5
		cell.Parent = card
		corner(cell, 74)
		local stroke = Instance.new("UIStroke")
		stroke.Color = ACCENT
		stroke.Thickness = 4
		stroke.Transparency = 1
		stroke.Parent = cell

		local avatar = Instance.new("ImageLabel")
		avatar.BackgroundTransparency = 1
		avatar.BorderSizePixel = 0
		avatar.ScaleType = info.scale
		avatar.Size = UDim2.fromScale(1, 1)
		avatar.ZIndex = 6
		avatar.Parent = cell
		corner(avatar, 74)

		local name = label(card, info.label, 15, TEXT, true)
		name.AnchorPoint = Vector2.new(0.5, 0)
		name.Position = UDim2.new(0.5, 0, 0, 166)
		name.Size = UDim2.new(1, 0, 0, 22)
		name.TextXAlignment = Enum.TextXAlignment.Center
		name.ZIndex = 5

		local modeButton = button(card, info.label, Color3.fromRGB(200, 206, 214))
		modeButton.AnchorPoint = Vector2.new(0.5, 1)
		modeButton.Position = UDim2.new(0.5, 0, 1, -4)
		modeButton.Size = UDim2.new(1, 0, 0, 36)
		modeButton.ZIndex = 5

		local function selectMode()
			self:_setAvatarMode(info.mode)
		end
		card.MouseButton1Click:Connect(selectMode)
		modeButton.MouseButton1Click:Connect(selectMode)

		self.skinPreviews[info.mode] = {
			info = info,
			cell = cell,
			avatar = avatar,
			stroke = stroke,
			button = modeButton,
			name = name,
		}
	end

	self:_loadSkinPreviews()
	self:_refreshSkins()
end

function MainMenu:_buildFriendsPage()
	local page = self:_page("friends")

	local spawnTitle = label(page, "Spawn near", 16, TEXT, true)
	spawnTitle.Size = UDim2.fromOffset(220, 22)

	self.spawnNearToggle = button(page, "Spawn near: ON", ACCENT)
	self.spawnNearToggle.Position = UDim2.fromOffset(0, 28)
	self.spawnNearToggle.Size = UDim2.fromOffset(180, 36)
	self.spawnNearToggle.MouseButton1Click:Connect(function()
		self.social.spawnNearEnabled = not self.social.spawnNearEnabled
		self:_fire({ action = "settings", spawnNearEnabled = self.social.spawnNearEnabled })
		self:_refreshSpawnNear()
	end)

	self.spawnTargetList = Instance.new("ScrollingFrame")
	self.spawnTargetList.BackgroundColor3 = PANEL2
	self.spawnTargetList.BorderSizePixel = 0
	self.spawnTargetList.Position = UDim2.fromOffset(0, 72)
