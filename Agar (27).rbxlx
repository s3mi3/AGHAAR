            <ProtectedString name="Source">local Players = game:GetService("Players")
local LocalizationService = game:GetService("LocalizationService")

local Localization = {}
Localization.__index = Localization

local TRANSLATIONS = {
	en = {
		shop_open = "Skins",
		shop_title = "Skins",
		nickname_placeholder = "Give yourself a name",
		avatar_full_body = "Full body",
		avatar_bust = "Bust",
		avatar_face = "Face",
		equipped = "Equipped",
		equip = "Equip",
